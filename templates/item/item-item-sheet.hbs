<form class="{{cssClass}} pink-card flex-col" autocomplete="off">
	<header class="sheet-header">
		<div class="fairytale-container">
			<img
				class="fairytale-frame"
				src="{{item.img}}"
				data-edit="img"
				title="{{item.name}}"
			/>
		</div>
		<div class="header-fields">
			<h1 class="charname"><input
					name="name"
					type="text"
					value="{{item.name}}"
					placeholder="Name"
				/></h1>
			<div class="grid grid-2">
				<div class="resource">
					<label class="resource-label">Quantity</label>
					<input
						type="text"
						name="system.quantity"
						value="{{system.quantity}}"
						data-dtype="Number"
					/>
				</div>
				<div class="resource">
					<label class="resource-label">Weight</label>
					<div class="flex-row">
						<div class="hd flex-col all-center">
							<input
								type="radio"
								name="system.weight"
								value="0"
								{{checked (eq system.weight 0)}}
								data-dtype="Number"
							/>
							<span class="tiny-text"> Weightless (0) </span>
						</div>
						<div class="hd flex-col all-center">
							<input
								type="radio"
								name="system.weight"
								value="1"
								{{checked (eq system.weight 1)}}
								data-dtype="Number"
							/>
							<span class="tiny-text">Normal (1)</span>
						</div>
						<div class="hd flex-col all-center">
							<input
								type="radio"
								name="system.weight"
								value="2"
								{{checked (eq system.weight 2)}}
								data-dtype="Number"
							/>
							<span class="tiny-text">Bulky (2)</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</header>

	{{! Sheet Tab Navigation }}
	<nav class="sheet-tabs tabs" data-group="primary">
		<a class="item" data-tab="description">Description</a>
		<a class="item" data-tab="attributes">Attributes</a>
	</nav>

	{{! Sheet Body }}
	<section class="sheet-body">

		{{! Description Tab }}
		<div class="tab" data-group="primary" data-tab="description">
			{{! Editors must receive enriched text data from getData to properly handle rolls }}
			{{editor
				enrichedDescription
				target="system.description"
				engine="prosemirror"
				button=true
				editable=editable
			}}
		</div>

		{{! Attributes Tab }}
		<div class="tab attributes" data-group="primary" data-tab="attributes">
			{{! As you add new fields, add them in here! }}
			<div class="resource all-center">
				<div class="grid grid-3">
					<div class="grid-span-1">
						<label class="resource-label">Number of Dice</label>
						<input
							type="text"
							name="system.roll.diceNum"
							value="{{system.roll.diceNum}}"
							data-dtype="Number"
						/>
					</div>
					<div class="grid-span-1">
						<label class="resource-label">Die Size</label>
						<input
							type="text"
							name="system.roll.diceSize"
							value="{{system.roll.diceSize}}"
							data-dtype="String"
						/>
					</div>
					<div class="grid-span-1">
						<label class="resource-label">Roll Modifier</label>
						<input
							type="text"
							name="system.roll.diceBonus"
							value="{{system.roll.diceBonus}}"
							data-dtype="String"
						/>
					</div>
					<div class="grid-span-3">
						<label class="resource-label">Relic Gift Dice</label>
						<span class="tiny-text">If this is a Magic Item or Relic with its
							own Gift Dice, keep track of charges here.</span>
						<div class="gift-dice-pool">
							<div class="dice-checkboxes flexrow all-center">
								<div class="flex-col all-center">
									<input
										type="checkbox"
										name="system.relicDice.relic1"
										{{checked system.relicDice.relic1}}
									/>
									<label class="tiny-text">I</label>
								</div>
								<div class="flex-col all-center">
									<input
										type="checkbox"
										name="system.relicDice.relic2"
										{{checked system.relicDice.relic2}}
									/>
									<label class="tiny-text">II</label>
								</div>
								<div class="flex-col all-center">
									<input
										type="checkbox"
										name="system.relicDice.relic3"
										{{checked system.relicDice.relic3}}
									/>
									<label class="tiny-text">III</label>
								</div>
								<div class="flex-col all-center">
									<input
										type="checkbox"
										name="system.relicDice.relic4"
										{{checked system.relicDice.relic4}}
									/>
									<label class="tiny-text">IV</label>
								</div>
								<span class="dice-divider"></span>
								<div class="flex-col all-center">
									<input
										type="checkbox"
										name="system.relicDice.extraRelic"
										{{checked system.relicDice.extraRelic}}
									/>
									<label class="tiny-text">Extra</label>
								</div>
							</div>
						</div>
					</div>
				</div>

			</div>
			{{! THE ROLL BUTTON }}
			<button
				type="button"
				class="pp-roll-btn pp-item-roll"
				data-roll-type="item"
			>
				<i class="fas fa-dice-d20"></i>
				Roll Item
			</button>
		</div>
	</section>
</form>